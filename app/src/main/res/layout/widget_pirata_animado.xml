<?xml version="1.0" encoding="utf-8"?>
<!--
    El pirata animado del widget de la racha: el ViewFlipper pasa solo de un fotograma
    al siguiente. Los dibujos de cada estado se ponen desde el código (Widgets.kt).
-->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pirata_animado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="550">

    <ImageView
        android:id="@+id/pirata_fotograma_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/pirata_fotograma_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/pirata_fotograma_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/pirata_fotograma_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />
</ViewFlipper>
